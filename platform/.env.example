# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Публичный адрес сайта без слэша в конце, например https://artchieve.example
SITE_URL=http://localhost:3000

# Подключение к базе. В Docker Compose собирается из POSTGRES_PASSWORD, локально можно задать целиком.
DATABASE_URL=postgres://artchieve:change-me@localhost:5432/artchieve
POSTGRES_PASSWORD=change-me

# Длинная случайная строка, не меньше 32 символов. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Почта (SMTP). Без неё в разработке код входа печатается в консоль, в продакшене письма не уходят.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ARTCHIEVE SERVICE <no-reply@example.ru>"

# Доверять заголовку X-Forwarded-For от обратного прокси (Caddy). В Docker Compose включено.
TRUST_PROXY=0

# Домен для Caddy (только для деплоя)
DOMAIN=localhost
